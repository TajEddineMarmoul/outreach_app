GMAIL_CREDENTIALS_PATH=credentials.json
APP_ENCRYPTION_KEY=replace-with-a-fernet-key
APP_ACCESS_TOKEN=replace-with-a-long-random-api-token
APP_USER_ID=replace-with-the-production-user-id
# Local development can use an existing account without copying APP_ACCESS_TOKEN.
# Leave delivery locked when this points at a production database.
APP_ENV=development
LOCAL_DEV_USER_ID=replace-with-your-local-development-user-id
OUTREACH_SAFE_LOCAL_MODE=true
OUTREACH_ALLOW_DELIVERY=false
# Do not apply schema migrations from a local process to a shared production database.
RUN_DATABASE_MIGRATIONS=false
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
WORKER_TICK_TOKEN=replace-with-a-long-random-token
# Gmail event tracking (Google Cloud Pub/Sub push)
GMAIL_PUBSUB_TOPIC=projects/your-project-id/topics/outreach-gmail-events
GMAIL_PUBSUB_PUSH_AUDIENCE=https://api.example.com/api/webhooks/gmail
GMAIL_PUBSUB_PUSH_SERVICE_ACCOUNT=outreach-gmail-push@your-project-id.iam.gserviceaccount.com
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials.json
GOOGLE_SHEETS_TOKEN_PATH=sheets_token.json
OUTREACH_DB_PATH=data/outreach.db
OUTREACH_CONFIG_PATH=config.yaml
